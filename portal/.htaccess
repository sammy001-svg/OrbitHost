# Orbit Cloud Client Portal — Apache config

Options -Indexes
ServerSignature Off

# Block direct access to the includes directory
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^includes/ - [F,L]
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(sql|md|log|sh|env)$">
  Order Deny,Allow
  Deny from all
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Portal pages render live database data (plan catalogue, services,
  # invoices) — never let a browser, proxy or server-side page cache reuse
  # one, or a plan the admin just added stays invisible to the client.
  # attachment.php is excluded: it streams files and sets its own header.
  <FilesMatch "^(?!attachment\.php$).*\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
  </FilesMatch>
</IfModule>
